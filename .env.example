# Baraholka «Скрудж Макдак» environment
# Keep real credentials in .env only. Never commit tokens.

# VK Community
VK_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_CALLBACK_SECRET=
VK_CONFIRMATION_TOKEN=

# Telegram bot (optional for VK-only deployments)
TELEGRAM_BOT_TOKEN=
# Telegram channel ID or @channelusername where approved Telegram listings are published
TELEGRAM_CHANNEL_ID=
# Telegram user IDs, comma-separated
TELEGRAM_ADMIN_IDS=
TELEGRAM_MODERATOR_IDS=

# Web server
HOST=0.0.0.0
PORT=8000

# VK user IDs, comma-separated
ADMIN_IDS=
MODERATOR_IDS=
SUPPORT_IDS=

# Storage
DATABASE_PATH=data/baraholka.db

# Logging
LOG_LEVEL=INFO

# Anti-spam
SPAM_WINDOW_SECONDS=10
SPAM_MAX_MESSAGES=8
SPAM_COOLDOWN_SECONDS=30

# Publication frequency
PUBLICATION_WINDOW_SECONDS=3600
PUBLICATION_MAX_COUNT=3
PUBLICATION_COOLDOWN_SECONDS=3600
