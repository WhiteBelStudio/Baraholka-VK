# Baraholka VK environment
# Never commit the real .env file to Git.

# VK Community
VK_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_CALLBACK_SECRET=
VK_CONFIRMATION_TOKEN=

# Web server
HOST=0.0.0.0
PORT=8000

# Admins (VK user IDs, comma-separated)
ADMIN_IDS=

# Storage
DATABASE_PATH=data/baraholka.db

# Logging
LOG_LEVEL=INFO
