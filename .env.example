# Baraholka VK environment
# Never commit the real .env file to Git.

# VK Community
VK_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_CALLBACK_SECRET=
VK_CONFIRMATION_TOKEN=

# Web server
HOST=0.0.0.0
PORT=8000

# Owners / full administrators (VK user IDs, comma-separated)
ADMIN_IDS=
# Moderators: moderation and complaint handling
MODERATOR_IDS=
# Support: user support/read-only administrative access
SUPPORT_IDS=

# Storage
DATABASE_PATH=data/baraholka.db

# Logging
LOG_LEVEL=INFO

# Anti-spam
SPAM_WINDOW_SECONDS=10
SPAM_MAX_MESSAGES=8
SPAM_COOLDOWN_SECONDS=30
